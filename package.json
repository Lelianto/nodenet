{
  "name": "nodenet",
  "version": "0.1.0",
  "description": "NodeNet maps code, context, ownership, and authority into an explainable graph so humans and AI can safely understand the impact of software changes.",
  "keywords": [
    "graph",
    "code-graph",
    "ownership",
    "authority",
    "governance",
    "living-context",
    "lcdd",
    "impact-analysis",
    "reviewers",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "nodenet": "dist/cli/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "typescript": "^5.6.3",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "fast-check": "^3.21.0",
    "vitest": "^2.1.4"
  }
}
