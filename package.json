{
  "name": "@antihero/nodenet",
  "version": "0.6.0",
  "description": "Governance-aware repository intelligence for AI agents: route changes, explain impact, and resolve the right reviewers. Deterministic and local-first.",
  "keywords": [
    "graph",
    "code-graph",
    "knowledge-graph",
    "dependency-graph",
    "static-analysis",
    "multi-language",
    "typescript",
    "javascript",
    "python",
    "golang",
    "java",
    "csharp",
    "php",
    "ownership",
    "authority",
    "governance",
    "living-context",
    "lcdd",
    "codeowners",
    "impact-analysis",
    "change-impact",
    "reviewers",
    "code-review",
    "merge-policy",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "developer-tools",
    "cli",
    "visualization",
    "graph-visualization"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Lelianto Pradana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lelianto/nodenet.git"
  },
  "homepage": "https://github.com/Lelianto/nodenet#readme",
  "bugs": {
    "url": "https://github.com/Lelianto/nodenet/issues"
  },
  "type": "module",
  "bin": {
    "nodenet": "dist/cli/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/adr",
    "docs/concepts",
    "docs/security",
    "docs/languages.md",
    "docs/decision-quality.md",
    "docs/design-partner-playbook.md",
    "docs/glossary.md",
    "docs/evaluation.md",
    "docs/verified-overrides.md",
    "docs/mcp-operations.md",
    "docs/product-positioning.md",
    "docs/token-efficiency-v2.md",
    "docs/experiments/nodenet-ab-medium-feature-verification-2026-08-09.md",
    "docs/experiments/governed-change-ab-protocol.md",
    "docs/logo.svg",
    "docs/language-support.svg",
    "docs/how-it-works.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:governance": "node scripts/benchmark-governance-fixture.mjs",
    "benchmark:languages": "node dist/cli/cli.js benchmark-languages --json",
    "test:e2e:self": "node scripts/e2e-self.mjs",
    "experiment:token-tasks": "npm run build && node scripts/e2e-self.mjs",
    "experiment:score-governed-ab": "node scripts/score-governed-change-ab.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@lcdd/core": "0.6.0",
    "commander": "^12.1.0",
    "typescript": "^5.6.3",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "fast-check": "^3.21.0",
    "vitest": "^2.1.4"
  }
}
